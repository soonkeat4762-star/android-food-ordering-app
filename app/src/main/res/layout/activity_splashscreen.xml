<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/coffee_background3"
    android:orientation="vertical"
    tools:context=".SplashScreen">

    <View
        android:id="@+id/topView1"
        android:layout_width="18dp"
        android:layout_height="120dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:background="@color/coco9"/>

    <View
        android:visibility="invisible"
        android:id="@+id/topView2"
        android:layout_toStartOf="@+id/topView1"
        android:layout_width="18dp"
        android:layout_height="90dp"
        android:layout_marginEnd="20dp"
        android:background="@color/coco10"/>

    <View
        android:visibility="invisible"
        android:id="@+id/topView3"
        android:layout_toStartOf="@+id/topView2"
        android:layout_width="18dp"
        android:layout_height="60dp"
        android:layout_marginEnd="20dp"
        android:background="@color/coco11"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/welcome_kopitiam"
                android:visibility="invisible"
                android:textAllCaps="true"
                android:paddingBottom="20dp"
                android:textColor="@color/coco6"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:visibility="invisible"
            android:id="@+id/splash_image_view"
            android:layout_width="300dp"
            android:paddingBottom="25dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:lottie_rawRes="@raw/logo_coffee"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <TextView
            android:visibility="invisible"
            android:id="@+id/slogan"
            android:layout_marginTop="3dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/robotocondensed_bolditalic"
            android:textColor="@color/coco6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"/>
    </LinearLayout>

    <View
        android:layout_alignParentBottom="true"
        android:id="@+id/bottomView1"
        android:layout_width="18dp"
        android:layout_height="120dp"
        android:layout_marginStart="20dp"
        android:background="@color/coco9"/>

    <View
        android:visibility="invisible"
        android:id="@+id/bottomView2"
        android:layout_toEndOf="@+id/bottomView1"
        android:layout_width="18dp"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:background="@color/coco10"/>

    <View
        android:visibility="invisible"
        android:id="@+id/bottomView3"
        android:layout_toEndOf="@+id/bottomView2"
        android:layout_width="18dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:background="@color/coco11"/>

</RelativeLayout>